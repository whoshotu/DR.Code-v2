# DR.CODE-v2 Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - Database
# =============================================================================
# Get this from MongoDB Atlas (free tier at https://cloud.mongodb.com)
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
DB_NAME=drcode

# =============================================================================
# REQUIRED - AI Provider
# =============================================================================
# Ollama (local) or Ollama Cloud
# Local: http://localhost:11434
# Cloud: https://api.ollama.ai/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# =============================================================================
# REQUIRED - CORS
# =============================================================================
# Frontend URL(s), comma-separated
# Local: http://localhost:3001
CORS_ORIGINS=http://localhost:3001

# =============================================================================
# OPTIONAL - Encryption
# =============================================================================
# Auto-generated on first run if not set
# SECRET_KEY=your-secret-key-here

# =============================================================================
# OPTIONAL - GitHub Integration
# =============================================================================
# Generate at: https://github.com/settings/tokens
# Scopes needed: repo, pull_requests
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# OPTIONAL - Webhook Security
# =============================================================================
# Secret string for HMAC verification of GitHub webhooks
# GITHUB_WEBHOOK_SECRET=your-webhook-secret
