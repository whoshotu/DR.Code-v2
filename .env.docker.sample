# DR.CODE-v2 Docker Environment
# ============================================
# Auto-detection: Leave values commented to auto-discover
# Explicit values: Uncomment and set to override auto-detection
# ============================================

# MongoDB: Auto-detects (docker network → localhost → env)
# Options:
#   - Leave commented: Auto-detect from docker network or localhost
#   - mongodb://mongo:27017 (docker internal)
#   - mongodb://localhost:27017 (host MongoDB)
#   - mongodb+srv://... (MongoDB Atlas)
# MONGO_URL=mongodb://mongo:27017

# Ollama: Auto-detects (docker internal → localhost → env)
# Options:
#   - Leave commented: Auto-detect from docker internal or localhost
#   - http://host.docker.internal:11434 (from Docker container to host)
#   - http://localhost:11434 (host Ollama)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=codellama

# Database
DB_NAME=drcode

# CORS
CORS_ORIGINS=http://localhost:3001

# Optional: GitHub Integration
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxx
# GITHUB_WEBHOOK_SECRET=your-secret
